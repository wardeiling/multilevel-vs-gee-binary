@incollection{doi:https://doi.org/10.1002/9781119041702.ch23,
	title = {Mixed-mode research},
	isbn = {978-1-119-04170-2},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119041702.ch23},
	abstract = {Summary This chapter reviews the methodology for design and analysis of mixed-mode surveys in a general way, highlighting design and analysis problems and choices. The objective of optimal design is to minimize the overall systematic measurement error using mixed-mode data. The deciding issue here is whether optimizing modes separately has the potential to reduce the mode measurement errors to a level lower than possible using unified mode design. Differentiating between mode selection effects and mode measurement effects and correcting for mode measurement effects require additional information. When a mixed-mode study is designed, the question where this additional information can be found or collected is part of the survey design. The chapter provides a literature review of publications on mode measurement effects with inclusion criterion that comparisons either show that there are no selection effects, or that an explicit adjustment to correct for selection effects is made when measurement effects are analyzed.},
