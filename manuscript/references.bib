@article{Shao1997,
	title = {An {Asymptotic} {Theory} for {Linear} {Model} {Selection}},
	volume = {7},
	abstract = {In the problem of selecting a linear model to approximate the true unknown regression model, some necessary and/or suucient conditions are established for the asymptotic validity of various model selection procedures such as Akaike's AIC, Mallows' Cp, Shibata's FPE , S c hwarz' BIC, generalized AIC, cross-validation, and generalized cross-validation. It is found that these selection procedures can be classiied into three classes according to their asymptotic behavior. Under some fairly weak conditions, the selection procedures in one class are asymp-totically valid if there exist txed-dimension correct modelss the selection procedures in another class are asymptotically valid if no oxed-dimension correct model exists. The procedures in the third class are compromises of the procedures in the erst two classes. Some empirical results are also presented.},
