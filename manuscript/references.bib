@incollection{doi:https://doi.org/10.1002/9781119041702.ch10,
	title = {Smartphone participation in web surveys},
	isbn = {978-1-119-04170-2},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119041702.ch10},
	abstract = {Summary This chapter provides research practitioners with an evidence-based framework to guide how to handle smartphone participation in Web surveys. When designing a web survey, a researcher must make two key decisions related to the incorporation of smartphones. First, regarding participation, a researcher must decide whether to actively disallow smartphone participation, discourage smartphone participation, or allow smartphone participation without discouraging. Second, conditional on smartphone participation, a researcher must decide whether or not to optimize the design of the instrument for use on mobile devices. The chapter documents its recent growth and prevalence and review which study types and sample sources seem to lead to the greatest smartphone participation to demonstrate that smartphone participation is worthy of continued investigation and attention. It summarizes published findings from a variety of market research and social science papers, conference presentations, and white papers dating back to 2010 to better understand recent trends in smartphone participation in Web surveys.},
