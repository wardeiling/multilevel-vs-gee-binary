	doi = {10.1007/BF02294210},
	abstract = {Proposes a structural equation model with a generalized measurement part, allowing for dichotomous and ordered categorical variables (indicators) in addition to continuous ones. A computationally feasible 3-stage estimator is proposed for any combination of observed variable types. Two multiple-indicator modeling examples are given. One is a simultaneous analysis of 2 groups with a structural equation model underlying skewed Likert variables. The 2nd is a longitudinal model with a structural model for multivariate probit regressions. (13 ref) (PsycInfo Database Record (c) 2025 APA, all rights reserved)},
	number = {1},
