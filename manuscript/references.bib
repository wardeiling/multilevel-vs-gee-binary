@incollection{doi:https://doi.org/10.1002/9781119041702.ch15,
	title = {Quantifying measurement errors in partially edited business survey data},
	isbn = {978-1-119-04170-2},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119041702.ch15},
	abstract = {Summary This chapter describes selective editing (SE), the SELEKT tool, and experiences from implementing it. It includes methods for drawing inference on error remaining after SE and models of measurement errors. The chapter also includes an example from Statistics Sweden on intratrade statistics within the European Union (EU) to illustrate and evaluate the methods and discusses the possibilities and challenges of adapting SE to big data. SE focuses mainly on minimizing and optimizing the microediting. There are apparent similarities between output editing by the aggregate method and selective microediting in that they both focus on the quality of the output of the survey. The advantages of SE are lower costs for respondents and the statistical agency and improved timeliness of the survey results. Efficient editing that focuses on minimizing recontacts with respondents is more complex for multistage samples, especially when the number of observed secondary units varies between primary selected units.},
