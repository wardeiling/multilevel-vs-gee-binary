@incollection{doi:https://doi.org/10.1002/9781119041702.ch18,
	title = {Classification error in crime victimization surveys},
	isbn = {978-1-119-04170-2},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781119041702.ch18},
	abstract = {Summary This chapter attempts to quantify the reporting errors in crime victimization surveys using a statistical modeling technique known as Markov Latent Class Analysis (MLCA). The chapter is unique in that it provides model-based estimates of classification error for the largest victimization survey in the U.S.A., namely, the U.S. National Crime Victimization Survey (NCVS). The chapter evaluates the error in questions that elicit whether or not a certain type of victimization has occurred during the survey reference period, that is, the so-called screener questions. Like other crime victimization surveys, the NCVS presents a number of important challenges for applying MLCA due to the complex sample design, low-prevalence outcomes, and high-dimensional data. The chapter shows how these challenges can be overcome in the modeling process using an innovative model-fitting approach developed by the authors specifically for MLCA applications to complex sample survey data.},
